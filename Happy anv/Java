    ? `<img class="entry__photo" src="${m.photo}" alt="${m.title}" loading="lazy">`
    : `<div class="entry__photo"></div>`;

  entry.innerHTML = `
    <span class="entry__star"></span>
    <span class="entry__date">${m.date}</span>
    <div class="entry__card">
      ${photoHTML}
      <div class="entry__body">
        <h2 class="entry__title">${m.title}</h2>
        <p class="entry__text">${m.text}</p>
      </div>
    </div>
