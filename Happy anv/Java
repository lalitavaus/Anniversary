/* ============================================================
   Day counter
   ============================================================ */
(function setCounter() {
  const start = new Date(START_DATE + "T00:00:00");
  const now = new Date();
  const days = Math.floor((now - start) / (1000 * 60 * 60 * 24));
  const years = (days / 365.25).toFixed(1);
  document.getElementById("day-counter").textContent =
    `${days.toLocaleString()} days together — about ${years} years`;

  const prettyDate = start.toLocaleDateString("en-US", {
    year: "numeric", month: "long", day: "numeric"
  });
  document.getElementById("anniv-date").textContent = prettyDate;
})();

/* ============================================================
   Constellation line — connects each star, draws in on scroll
   ============================================================ */
function drawConstellation() {
  const svg = document.getElementById("constellation-line");
  const path = document.getElementById("constellation-path");
  const timeline = document.getElementById("timeline");
  const stars = Array.from(document.querySelectorAll(".entry__star"));
  if (!stars.length) return;

  const timelineRect = timeline.getBoundingClientRect();
  const scrollY = window.scrollY || window.pageYOffset;

  svg.setAttribute("viewBox", `0 0 3 ${timelineRect.height}`);
  svg.style.height = `${timelineRect.height}px`;

  const points = stars.map((star) => {
    const r = star.getBoundingClientRect();
    const y = r.top + scrollY - (timelineRect.top + scrollY) + r.height / 2;
    return `1.5,${y.toFixed(1)}`;
  });

  path.setAttribute("d", `M ${points.join(" L ")}`);

  const length = path.getTotalLength();
  path.style.strokeDasharray = length;
  path.style.strokeDashoffset = length;
}

function revealOnScroll() {
  const path = document.getElementById("constellation-path");
  const length = path.getTotalLength();
  const entries = document.querySelectorAll(".entry");
  const viewportBottom = window.scrollY + window.innerHeight * 0.82;

  let lastVisibleIndex = -1;
  entries.forEach((entry, i) => {
    const star = entry.querySelector(".entry__star");
    const rect = star.getBoundingClientRect();
    const y = rect.top + window.scrollY;
    if (y < viewportBottom) {
      entry.classList.add("is-visible");
      lastVisibleIndex = i;
    }
  });

  if (lastVisibleIndex >= 0) {
    const stars = document.querySelectorAll(".entry__star");
    const targetStar = stars[lastVisibleIndex];
    const timeline = document.getElementById("timeline");
    const timelineTop = timeline.getBoundingClientRect().top + window.scrollY;
    const targetY = targetStar.getBoundingClientRect().top + window.scrollY - timelineTop;

    // Estimate how far along the path this vertical position is
    const total = entries.length - 1 || 1;
    const progress = lastVisibleIndex / total;
    const offset = length - length * progress;
    path.style.strokeDashoffset = Math.max(offset, 0);
  }
}

window.addEventListener("load", () => {
  drawConstellation();
  revealOnScroll();
});
window.addEventListener("resize", () => {
  drawConstellation();
  revealOnScroll();
});
window.addEventListener("scroll", revealOnScroll, { passive: true });

/* ============================================================
   Starfield background — subtle twinkle, respects reduced motion
   ============================================================ */
(function starfield() {
  const canvas = document.getElementById("starfield");
  const ctx = canvas.getContext("2d");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let stars = [];

  function resize() {
    canvas.width = window.innerWidth;
    canvas.height = document.body.scrollHeight;
    const count = Math.floor((canvas.width * canvas.height) / 9000);
    stars = Array.from({ length: count }, () => ({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height,
      r: Math.random() * 1.2 + 0.3,
      phase: Math.random() * Math.PI * 2,
      speed: Math.random() * 0.015 + 0.005
    }));
  }

  function draw(t) {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = "#f5efe0";
    stars.forEach((s) => {
      const twinkle = reduceMotion ? 0.6 : 0.4 + Math.sin(t * s.speed + s.phase) * 0.35;
      ctx.globalAlpha = Math.max(twinkle, 0.05);
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fill();
    });
    ctx.globalAlpha = 1;
    if (!reduceMotion) requestAnimationFrame(draw);
  }

  window.addEventListener("resize", resize);
  resize();
  requestAnimationFrame(draw);
})();